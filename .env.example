# Copy to .env and fill in real values. NEVER put real secrets in this file —
# it is committed to git. No VITE_ prefix for credentials: VITE_ vars are
# embedded in the public JS bundle.

# WordPress (editorial backend) — used by tools/migrate-from-wp.js, run locally
WP_SITE_URL=https://blog.reagleeagle.com
WP_USERNAME=your_wordpress_username
WP_APP_PASSWORD=your_application_password_here
WP_CATEGORY_THERAPIST_RESOURCES=5

# n8n (automation layer)
N8N_API_URL=https://your-n8n-instance/
N8N_API_KEY=your_n8n_api_key

# Fine-grained GitHub PAT for the n8n "GitHub Contents (TR site)" credential
N8N_FINEGRAINED_ACCESS_TOKEN=your_github_pat

# Shared secret between wp/tr-blog-webhook.php and the n8n "TR Blog Sync" webhook
TR_BLOG_WEBHOOK_SECRET=your_random_secret
